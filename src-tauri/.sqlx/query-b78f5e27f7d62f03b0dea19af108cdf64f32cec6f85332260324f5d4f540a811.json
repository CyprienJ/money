  "query": "SELECT id, opening_date AS \"date!: NaiveDate\", currency, is_joint AS \"is_joint: bool\",\n                  opening_balance_cents AS \"amount_cents!: i64\"\n           FROM account\n           WHERE type IN ('CHECKING', 'SAVINGS', 'CREDIT_CARD')\n             AND CASE WHEN ?1 IS NULL\n                      THEN archived = 0\n                      ELSE id IN (SELECT value FROM json_each(?1)) END",
