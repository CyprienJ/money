  "query": "SELECT v.account_id, a.type AS \"account_type: AccountType\",\n                  v.date AS \"date!: NaiveDate\", v.value_cents\n           FROM valuation v\n           JOIN account a ON a.id = v.account_id\n           WHERE a.archived = 0 AND v.date <= ?1\n           ORDER BY v.account_id, v.date",
