  "query": "SELECT a.id, o.date AS \"date!: NaiveDate\", a.currency, a.is_joint AS \"is_joint: bool\", o.amount_cents AS \"amount!: i64\"\n           FROM operation o\n           JOIN account a ON a.id = o.account_id\n           WHERE a.archived = 0 AND a.type IN ('CHECKING', 'SAVINGS', 'CREDIT_CARD')\n             AND o.date <= ?1",
